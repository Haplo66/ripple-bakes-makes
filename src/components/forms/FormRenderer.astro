---
import type { Form } from '../../types/form';
import FormField from './FormField.astro';
import { getFormById } from '../../data/forms';

interface Props {
  form?: Form;
  formId?: string;
  fallbackTitle?: string;
  product: {
    collectionId: string;
    productId: string;
    productTitle: string;
    price?: number;
  };
}

const { form: providedForm, formId, fallbackTitle, product } = Astro.props;
const form = providedForm || (formId ? getFormById(formId) : undefined) || {
  id: formId || `${product.productId}-cart-form`,
  name: fallbackTitle || product.productTitle,
  title: fallbackTitle || product.productTitle,
  fields: [],
};
---

<form
  class="product-form"
  action="#"
  method="post"
  data-dynamic-form
  data-cart-form
  data-collection-id={product.collectionId}
  data-product-id={product.productId}
  data-product-title={product.productTitle}
  data-product-price={product.price}
>
  <div class="product-form__header">
    <span class="eyebrow">Customize Order</span>
    <h2>{form.title}</h2>
  </div>

  <div class="product-form__fields" data-cart-fields>
    {form.fields.map((field) => <FormField field={field} />)}

    <label class="product-form__notes">
      Comments
      <textarea
        name="notes"
        placeholder="Special requests, dietary needs, or anything else..."
        rows="3"
      ></textarea>
    </label>

    <label class="product-form__quantity">
      Quantity
      <input
        type="number"
        name="quantity"
        min="1"
        step="1"
        value="1"
        required
      />
    </label>
  </div>

  <button class="button button--honey" type="submit">
    Add to cart
    <span class="arrow" aria-hidden="true">→</span>
  </button>

  <p class="product-form__confirmation" data-cart-confirmation hidden>
    Added to cart
  </p>
</form>

<script>
  import { addToCart } from '../../utils/cart';

  const PLACEHOLDER_PATTERNS = [
    /^select one$/i,
    /^select\.\.\.$/i,
    /^choose one$/i,
    /^choose\.\.\.$/i,
    /^please select/i,
    /^select a?n?o?t?h?e?r?$/i,
  ];

  const isPlaceholderValue = (value: string): boolean => {
    if (!value || !value.trim()) return true;
    return PLACEHOLDER_PATTERNS.some((pattern) => pattern.test(value.trim()));
  };

  const forms = document.querySelectorAll<HTMLFormElement>('[data-dynamic-form]');

  forms.forEach((form) => {
    const conditionalFields = form.querySelectorAll<HTMLElement>('[data-condition-field]');

    const setFieldState = (field: HTMLElement, isVisible: boolean) => {
      field.hidden = !isVisible;

      field
        .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
        .forEach((input) => {
          input.disabled = !isVisible;
          input.required =
            isVisible && input.dataset.required === 'true';
        });
    };

    const getFieldValue = (fieldId: string) => {
      const checked = form.querySelector<HTMLInputElement>(
        `[name="${fieldId}"]:checked`,
      );

      if (checked) {
        return checked.value;
      }

      const select = form.querySelector<HTMLSelectElement>(`[name="${fieldId}"]`);
      if (select) {
        return select.value;
      }

      const input = form.querySelector<HTMLInputElement>(`[name="${fieldId}"]`);
      return input?.value;
    };

    const updateConditions = () => {
      conditionalFields.forEach((field) => {
        const dependsOn = field.dataset.conditionField;
        const expectedValue = field.dataset.conditionEquals;

        if (!dependsOn) {
          return;
        }

        setFieldState(
          field,
          String(getFieldValue(dependsOn)) === expectedValue,
        );
      });
    };

    form.addEventListener('input', updateConditions);
    form.addEventListener('change', updateConditions);
    updateConditions();
  });

  const cartForms = document.querySelectorAll<HTMLFormElement>('[data-cart-form]');

  cartForms.forEach((form) => {
    const confirmation = form.querySelector<HTMLElement>('[data-cart-confirmation]');

    const otherInputs = form.querySelectorAll<HTMLElement>('[data-other-input]');

    otherInputs.forEach((otherInput) => {
      const fieldId = otherInput.dataset.otherInput;
      const select = form.querySelector<HTMLSelectElement>(`[name="${fieldId}"]`);
      const radios = form.querySelectorAll<HTMLInputElement>(`[name="${fieldId}"][type="radio"]`);

      const toggleOther = () => {
        let value = '';
        if (select) {
          value = select.value;
        } else if (radios.length > 0) {
          const checked = form.querySelector<HTMLInputElement>(`[name="${fieldId}"][type="radio"]:checked`);
          value = checked?.value || '';
        }
        otherInput.hidden = value !== 'other';
      };

      if (select) {
        select.addEventListener('change', toggleOther);
      }
      radios.forEach((radio) => {
        radio.addEventListener('change', toggleOther);
      });
      toggleOther();
    });

    const getConfiguration = () => {
      const data = new FormData(form);
      const configuration: Record<string, string | string[]> = {};

      data.forEach((value, key) => {
        if (key === 'quantity' || key === 'notes') {
          return;
        }

        if (key.endsWith('-other')) {
          return;
        }

        const stringValue = String(value);

        if (stringValue === 'other') {
          const otherKey = `${key}-other`;
          const otherValue = data.get(otherKey);
          configuration[key] = stringValue;

          if (otherValue) {
            configuration[otherKey] = String(otherValue);
          }

          return;
        }

        const currentValue = configuration[key];

        if (Array.isArray(currentValue)) {
          currentValue.push(stringValue);
          return;
        }

        if (typeof currentValue === 'string') {
          configuration[key] = [currentValue, stringValue];
          return;
        }

        configuration[key] = stringValue;
      });

      return configuration;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        return;
      }

      const fields = form.querySelectorAll<HTMLElement>('[data-form-field]');
      let hasValidationErrors = false;

      fields.forEach((fieldEl) => {
        const fieldId = fieldEl.dataset.formField;
        const fieldType = fieldEl.dataset.fieldType;
        const isRequired = fieldEl.dataset.fieldRequired === 'true';
        const fieldLabel = fieldEl.querySelector<HTMLElement>('label, legend');
        const labelText = fieldLabel?.textContent?.trim() || fieldId || 'This field';
        const existingError = fieldEl.querySelector<HTMLElement>('.form-field__error');

        if (!isRequired) {
          existingError?.remove();
          fieldEl.removeAttribute('data-invalid');
          return;
        }

        const input = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          `[name="${fieldId}"]`,
        );

        if (!input) {
          existingError?.remove();
          fieldEl.removeAttribute('data-invalid');
          return;
        }

        const value = input instanceof HTMLSelectElement && input.multiple
          ? Array.from(input.selectedOptions).map((o) => o.value)
          : input.value;

        let isValid = true;

        if (fieldType === 'dropdown' && isPlaceholderValue(value as string)) {
          isValid = false;
        } else if (fieldType === 'checkbox' && fieldEl.dataset.fieldRequired === 'true') {
          const checked = form.querySelectorAll<HTMLInputElement>(
            `[name="${fieldId}"]:checked`,
          );
          if (checked.length === 0) {
            isValid = false;
          }
        }

        if (!isValid) {
          hasValidationErrors = true;
          fieldEl.setAttribute('data-invalid', 'true');
          const isCheckbox = fieldType === 'checkbox';
          const message = isCheckbox
            ? `Please check ${labelText}`
            : `Please select a value for ${labelText}`;
          if (!existingError) {
            const errorEl = document.createElement('p');
            errorEl.className = 'form-field__error';
            errorEl.textContent = message;
            fieldEl.appendChild(errorEl);
          } else {
            existingError.textContent = message;
          }
        } else {
          existingError?.remove();
          fieldEl.removeAttribute('data-invalid');
        }
      });

      if (hasValidationErrors) {
        const firstInvalid = form.querySelector<HTMLElement>('[data-invalid]');
        firstInvalid?.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input, select, textarea',
        )?.focus();
        return;
      }

      const rawPrice = form.dataset.productPrice;
      const price = rawPrice ? Number(rawPrice) : undefined;

      if (price == null || !Number.isFinite(price)) {
        return;
      }

      const formData = new FormData(form);
      const quantity = Number(formData.get('quantity') || 1);
      const notesValue = formData.get('notes');

      addToCart({
        collectionId: form.dataset.collectionId || '',
        productId: form.dataset.productId || '',
        productTitle: form.dataset.productTitle || '',
        price: Number.isFinite(price) ? price : undefined,
        configuration: getConfiguration(),
        quantity,
        notes: notesValue ? String(notesValue) : undefined,
      });

      if (confirmation) {
        confirmation.hidden = false;
      }
    });
  });
</script>

<style>
  .product-form {
    background: #f6eddf;
    border-radius: 1.1rem;
    margin-top: 1.75rem;
    padding: 1.5rem;
  }

  .product-form__header {
    margin-bottom: 1.15rem;
  }

  .product-form__header h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: 1.1;
    margin: .4rem 0 0;
  }

  .product-form__fields {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 1.2rem;
  }

  .product-form__fields :global(.form-field:has(textarea)),
  .product-form__fields :global(.form-field:has(fieldset):not([data-field-type='toggle'])) {
    grid-column: span 2;
  }

  .product-form__notes {
    color: var(--cocoa);
    display: flex;
    flex-direction: column;
    font-size: .78rem;
    font-weight: 600;
    gap: .4rem;
    grid-column: span 2;
  }

  .product-form__notes textarea {
    background: #fffdfa;
    border: 1px solid var(--line);
    border-radius: .55rem;
    color: var(--cocoa);
    font-size: .92rem;
    outline-color: var(--honey);
    padding: .72rem .8rem;
    resize: vertical;
  }

  .product-form__quantity {
    color: var(--cocoa);
    display: flex;
    flex-direction: column;
    font-size: .78rem;
    font-weight: 600;
    gap: .4rem;
  }

  .product-form__quantity input {
    background: #fffdfa;
    border: 1px solid var(--line);
    border-radius: .55rem;
    color: var(--cocoa);
    font-size: .92rem;
    outline-color: var(--honey);
    padding: .72rem .8rem;
  }

  .product-form__confirmation {
    color: var(--sage);
    font-size: .85rem;
    font-weight: 600;
    margin: .85rem 0 0;
  }

  [data-invalid] {
    outline: 2px solid var(--rust);
    outline-offset: .25rem;
    border-radius: .55rem;
  }

  .form-field__error {
    color: var(--rust);
    font-size: .72rem;
    font-weight: 600;
    margin: .25rem 0 0;
  }

  @media (max-width: 620px) {
    .product-form__fields {
      grid-template-columns: 1fr;
    }

    .product-form__fields :global(.form-field:has(textarea)),
    .product-form__fields :global(.form-field:has(fieldset):not([data-field-type='toggle'])) {
      grid-column: auto;
    }
  }
</style>
