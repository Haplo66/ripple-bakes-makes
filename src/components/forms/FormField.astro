---
import type { FormField } from '../../types/form';
import { resolveFieldType } from '../../types/form';

interface Props {
  field: FormField;
}

const { field } = Astro.props;
const fieldId = `field-${field.id}`;
const resolvedType = resolveFieldType(field.type);
const hasOptions = Boolean(field.options?.length);
const inputType = (resolvedType === 'phone' ? 'tel' : resolvedType) as
  | 'text'
  | 'number'
  | 'date'
  | 'email'
  | 'tel'
  | 'radio'
  | 'checkbox';
const showOther = (resolvedType === 'selection' || resolvedType === 'dropdown') && field.options?.some((o) => /other/i.test(o.label));
const otherInputName = field.id + '-other';
const otherPlaceholder = 'Enter your ' + field.label.toLowerCase();
const validationAttributes = {
  minlength: field.validation?.minLength,
  maxlength: field.validation?.maxLength,
  pattern: field.validation?.pattern,
};
---

<div
  class="form-field"
  data-form-field={field.id}
  data-field-type={resolvedType}
  data-field-required={field.required ? 'true' : 'false'}
  data-condition-field={field.condition?.fieldId}
  data-condition-equals={field.condition?.equals}
  hidden={Boolean(field.condition)}
>
  {
    resolvedType === 'textarea' ? (
      <label for={fieldId}>
        {field.label}
        {!field.required && <span>(optional)</span>}
      </label>

      <textarea
        id={fieldId}
        name={field.id}
        required={field.required}
        data-required={field.required ? 'true' : 'false'}
        placeholder={field.placeholder}
        {...validationAttributes}
        rows="4"
      >
        {field.defaultValue}
      </textarea>
    ) : resolvedType === 'dropdown' ? (
      <label for={fieldId}>
        {field.label}
        {!field.required && <span>(optional)</span>}
      </label>

      <select
        id={fieldId}
        name={field.id}
        required={field.required}
        data-required={field.required ? 'true' : 'false'}
      >
        <option value="">Select one</option>
        {field.options?.map((option) => (
          <option
            value={option.value}
            selected={option.value === field.defaultValue}
          >
            {option.label}
          </option>
        ))}
      </select>
    ) : resolvedType === 'selection' && hasOptions ? (
      <fieldset>
        <legend>
          {field.label}
          {!field.required && <span>(optional)</span>}
        </legend>

        <div class="choice-list">
          {field.options?.map((option) => (
            <label class="choice">
              <input
                type="radio"
                name={field.id}
                value={option.value}
                required={field.required}
                data-required={field.required ? 'true' : 'false'}
                checked={option.value === field.defaultValue}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ) : resolvedType === 'toggle' && hasOptions ? (
      <fieldset>
        <legend>
          {field.label}
          {!field.required && <span>(optional)</span>}
        </legend>

        <div class="choice-list">
          {field.options?.map((option) => (
            <label class="choice">
              <input
                type="radio"
                name={field.id}
                value={option.value}
                required={field.required}
                data-required={field.required ? 'true' : 'false'}
                checked={option.value === field.defaultValue}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ) : resolvedType === 'checkbox' && hasOptions ? (
      <fieldset>
        <legend>
          {field.label}
          {!field.required && <span>(optional)</span>}
        </legend>

        <div class="choice-list">
          {field.options?.map((option) => (
            <label class="choice">
              <input
                type="checkbox"
                name={field.id}
                value={option.value}
                required={field.required}
                data-required={field.required ? 'true' : 'false'}
                checked={field.defaultValue?.split(',').includes(option.value)}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ) : resolvedType === 'checkbox' ? (
      <label class="choice choice--single">
        <input
          id={fieldId}
          type="checkbox"
          name={field.id}
          required={field.required}
          data-required={field.required ? 'true' : 'false'}
        />
        <span>{field.label}</span>
      </label>
    ) : (
      <label for={fieldId}>
        {field.label}
        {!field.required && <span>(optional)</span>}
      </label>

      <input
        id={fieldId}
        type={inputType}
        name={field.id}
        required={field.required}
        data-required={field.required ? 'true' : 'false'}
        placeholder={field.placeholder}
        value={field.defaultValue}
        {...validationAttributes}
      />
    )
  }

  {showOther && <label class="form-field__other" data-other-input={field.id} hidden>Please specify<input type="text" name={otherInputName} placeholder={otherPlaceholder} /></label>}

  {field.helpText && <p class="form-field__help">{field.helpText}</p>}
</div>

<style>
  .form-field {
    color: var(--cocoa);
    display: flex;
    flex-direction: column;
    font-size: .78rem;
    font-weight: 600;
    gap: .4rem;
  }

  .form-field[hidden] {
    display: none;
  }

  label span,
  legend span {
    color: var(--muted);
    font-weight: 400;
    margin-left: .25rem;
  }

  input,
  select,
  textarea {
    background: #fffdfa;
    border: 1px solid var(--line);
    border-radius: .55rem;
    color: var(--cocoa);
    font-size: .92rem;
    outline-color: var(--honey);
    padding: .72rem .8rem;
  }

  select[multiple] {
    min-height: 8.5rem;
  }

  textarea {
    resize: vertical;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  legend {
    margin-bottom: .4rem;
    padding: 0;
  }

  .choice-list {
    display: grid;
    gap: .45rem;
  }

  .choice {
    align-items: center;
    display: flex;
    flex-direction: row;
    font-size: .9rem;
    font-weight: 500;
    gap: .55rem;
  }

  .choice input {
    accent-color: var(--honey);
    flex: 0 0 auto;
    padding: 0;
  }

  .choice:has(input:checked) {
    color: var(--honey);
  }

  .choice:has(input:checked)::before {
    content: '';
    width: .65rem;
    height: .65rem;
    border-radius: 50%;
    border: 2px solid var(--honey);
    background: var(--cream);
    box-shadow: inset 0 0 0 2px var(--honey);
    flex-shrink: 0;
    margin-right: .35rem;
  }

  .choice--single {
    margin-top: .2rem;
  }

  .form-field__other {
    display: flex;
    flex-direction: column;
    font-size: .78rem;
    font-weight: 600;
    gap: .4rem;
    margin-top: .25rem;
  }

  .form-field__other[hidden] {
    display: none;
  }

  .form-field__help {
    color: var(--muted);
    font-size: .76rem;
    font-weight: 400;
    margin: 0;
  }
</style>
