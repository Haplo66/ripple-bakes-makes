---
import SectionTitle from './SectionTitle.astro';
import ProductGrid from './products/ProductGrid.astro';
import type { Collection } from '../types/collection';
import type { Product } from '../types/product';
import { getCollectionPrimaryImage } from '../utils/images';
import { sitePath } from '../utils/paths';
interface Props { collection: Collection; products?: readonly Product[] }
const { collection, products = [] } = Astro.props;
const primaryImage = getCollectionPrimaryImage(collection);
const hasGallery = collection.galleryImages.length > 0;
const hasIdeas = collection.popularIdeas.length > 0;
const hasCustomization = collection.customizationNote.length > 0;
---
<section class={`collection-hero image-panel--${collection.imageTone}`}>{primaryImage && <img class="collection-hero__img" src={primaryImage} alt={collection.title} />}<div class="collection-hero__overlay" /><div class="container"><span class="eyebrow">{collection.category} collection</span><h1 class="display">{collection.title}</h1><p>{collection.subtitle}</p></div></section>
<section class="section"><div class="container intro"><span class="eyebrow">About this collection</span><p>{collection.description}</p></div></section>
{products.length > 0 && <section class="section section--paper"><div class="container"><SectionTitle eyebrow="Products" title={`Explore our <em>${collection.title.toLowerCase().replace(/\b\w/g, char => char.toUpperCase())}.</em>`}/><ProductGrid products={products}/></div></section>}
{hasGallery && <section class="section section--paper"><div class="container"><SectionTitle eyebrow="Gallery" title={`A closer look at <em>${collection.title.toLowerCase()}.</em>`}/><div class="collection-gallery">{collection.galleryImages.map((image)=><figure><div class:list={['collection-gallery__image',`image-panel--${image.tone}`]}>{image.src && <img class="collection-gallery__img" src={image.src} alt={image.alt} />}</div><figcaption>{image.caption}</figcaption></figure>)}</div></div></section>}
{hasIdeas && <section class="section"><div class="container"><SectionTitle eyebrow="Popular ideas" title="A few ways to make it <em>yours.</em>"/><ul class="ideas">{collection.popularIdeas.map((idea,index)=><li><span>0{index + 1}</span>{idea}</li>)}</ul></div></section>}
{hasCustomization && <section class="section section--paper"><div class="container customization"><div><span class="eyebrow">Customization</span><h2 class="display">Made with your<br/><em>details</em> in mind.</h2></div><p>{collection.customizationNote}</p></div></section>}
<section class="section"><div class="container"><div class="collection-cta"><span class="eyebrow">Have a question?</span><h2 class="display">Ask about <em>this collection.</em></h2><p>Curious about ingredients, sizing, turnaround time, or something else? We are here to help and would love to hear from you.</p><a class="button" href={sitePath('contact')}>Ask About This Collection <span class="arrow" aria-hidden="true">→</span></a></div></div></section>
<style>.collection-hero{min-height:430px;overflow:hidden;padding:8rem 0 5rem;position:relative}.collection-hero__img{display:block;height:100%;left:0;object-fit:cover;position:absolute;top:0;width:100%}.collection-hero__overlay{background:linear-gradient(90deg,rgba(74,51,38,.26),transparent);inset:0;pointer-events:none;position:absolute;z-index:1}.collection-hero .container{position:relative;z-index:2}.collection-hero .eyebrow{color:#fff7ea}.collection-hero .display{color:#fff;max-width:700px}.collection-hero p{color:#fff7ea;font-size:1.1rem;max-width:500px}.intro{max-width:760px}.intro>p{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.35;margin:.8rem 0 0}.collection-gallery{display:grid;gap:1rem;grid-template-columns:repeat(3,1fr)}.collection-gallery figure{margin:0}.collection-gallery__image{height:300px;overflow:hidden;position:relative}.collection-gallery__img{display:block;height:100%;object-fit:cover;width:100%}.collection-gallery figcaption{color:var(--muted);font-size:.82rem;margin-top:.6rem}.ideas{display:grid;gap:1rem;grid-template-columns:repeat(3,1fr);list-style:none;margin:0;padding:0}.ideas li{border-top:1px solid var(--line);font-family:'Playfair Display',serif;font-size:1.35rem;padding-top:.8rem}.ideas span{color:var(--sage);display:block;font-family:'DM Sans',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.1em;margin-bottom:.5rem}.customization{align-items:center;display:grid;gap:4rem;grid-template-columns:1fr 1fr}.customization p{color:var(--muted);font-size:1.05rem}.collection-cta{max-width:560px}.collection-cta p{color:var(--muted);font-size:1.05rem;margin:0 0 1.5rem}@media(max-width:720px){.collection-hero{min-height:370px;padding-top:6rem}.collection-gallery,.ideas{grid-template-columns:1fr}.collection-gallery__image{height:250px}.customization{gap:1.5rem;grid-template-columns:1fr}}</style>