---
import type { CollectionImageTone } from '../../types/collection';

interface Props {
  images: string[];
  primaryImage: string | null;
  imageTone?: CollectionImageTone;
  title: string;
}

const { images, primaryImage, imageTone = 'cream', title } = Astro.props;
const hasImages = images.length > 0;
const mainImage = primaryImage || (hasImages ? images[0] : null);
---

<div class="product-gallery">
  <div class:list={['product-gallery__main', `image-panel--${imageTone}`]} data-gallery-main>
    {mainImage
      ? <img class="product-gallery__main-img" src={mainImage} alt={title} />
      : <div class="product-gallery__main-placeholder" />}
    <div class="product-gallery__overlay"><slot name="overlay" /></div>
  </div>

  {images.length > 1 && (
    <div class="product-gallery__thumbs">
      {images.map((url, index) => (
        <button
          class:list={[
            'product-gallery__thumb',
            `image-panel--${imageTone}`,
            index === 0 && 'product-gallery__thumb--active',
          ]}
          aria-label={`${title} image ${index + 1}`}
          data-thumb={index}
        >
          <img class="product-gallery__thumb-img" src={url} alt="" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const mainImg = document.querySelector<HTMLImageElement>('[data-gallery-main] .product-gallery__main-img');
  const thumbEls = document.querySelectorAll('[data-thumb]');

  if (mainImg && thumbEls.length > 0) {
    thumbEls.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const thumbImg = thumb.querySelector<HTMLImageElement>('.product-gallery__thumb-img');
        if (thumbImg) {
          mainImg.src = thumbImg.src;
          mainImg.srcset = thumbImg.srcset || '';
          thumbEls.forEach((t) =>
            t.classList.remove('product-gallery__thumb--active'),
          );
          thumb.classList.add('product-gallery__thumb--active');
        }
      });
    });
  }
</script>

<style>
  .product-gallery__main {
    background-position: center;
    background-size: cover;
    min-height: 400px;
    position: relative;
  }

  .product-gallery__main-img {
    display: block;
    height: 100%;
    left: 0;
    object-fit: contain;
    position: absolute;
    top: 0;
    width: 100%;
  }

  .product-gallery__main-placeholder {
    height: 100%;
    width: 100%;
  }

  .product-gallery__overlay {
    position: relative;
    z-index: 1;
  }

  .product-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .product-gallery__thumb {
    border: 2px solid transparent;
    border-radius: 0.6rem;
    cursor: pointer;
    height: 80px;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 80px;
  }

  .product-gallery__thumb-img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .product-gallery__thumb:hover {
    border-color: var(--honey);
  }

  .product-gallery__thumb--active {
    border-color: var(--honey);
  }
</style>
