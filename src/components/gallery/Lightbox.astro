---
const { id = 'gallery-lightbox' } = Astro.props;
---

<div id={id} class="lightbox" aria-hidden="true" role="dialog" aria-label="Image viewer">
  <div class="lightbox__backdrop"></div>
  <div class="lightbox__content">
    <button class="lightbox__close" type="button" aria-label="Close">&times;</button>
    <img class="lightbox__img" src="" alt="" />
    <div class="lightbox__info">
      <h3 class="lightbox__title"></h3>
      <p class="lightbox__description"></p>
      <a class="lightbox__link" href="" hidden></a>
    </div>
  </div>
</div>

<script>
  interface LightboxState {
    image: string;
    title: string;
    description: string;
    href: string;
    cta: string;
  }

  class GalleryLightbox {
    private el: HTMLElement;
    private img: HTMLImageElement;
    private closeBtn: HTMLButtonElement;
    private backdrop: HTMLElement;
    private titleEl: HTMLElement;
    private descriptionEl: HTMLElement;
    private linkEl: HTMLAnchorElement;
    private state: LightboxState | null = null;

    constructor(id: string) {
      this.el = document.getElementById(id) as HTMLElement;
      this.img = this.el.querySelector('.lightbox__img') as HTMLImageElement;
      this.closeBtn = this.el.querySelector('.lightbox__close') as HTMLButtonElement;
      this.backdrop = this.el.querySelector('.lightbox__backdrop') as HTMLElement;
      this.titleEl = this.el.querySelector('.lightbox__title') as HTMLElement;
      this.descriptionEl = this.el.querySelector('.lightbox__description') as HTMLElement;
      this.linkEl = this.el.querySelector('.lightbox__link') as HTMLAnchorElement;

      this.closeBtn.addEventListener('click', () => this.close());
      this.backdrop.addEventListener('click', () => this.close());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.state) this.close();
      });
    }

    open(state: LightboxState) {
      this.state = state;
      this.img.src = state.image;
      this.img.alt = state.title;
      this.titleEl.textContent = state.title;

      if (state.description) {
        this.descriptionEl.textContent = state.description;
        this.descriptionEl.hidden = false;
      } else {
        this.descriptionEl.textContent = '';
        this.descriptionEl.hidden = true;
      }

      if (state.href) {
        this.linkEl.href = state.href;
        this.linkEl.textContent = `${state.cta || 'View Product'} →`;
        this.linkEl.hidden = false;
      } else {
        this.linkEl.href = '';
        this.linkEl.textContent = '';
        this.linkEl.hidden = true;
      }

      this.el.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    close() {
      this.state = null;
      this.img.src = '';
      this.img.alt = '';
      this.titleEl.textContent = '';
      this.descriptionEl.textContent = '';
      this.linkEl.href = '';
      this.linkEl.textContent = '';
      this.el.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  const lightbox = new GalleryLightbox('gallery-lightbox');

  document.querySelectorAll('[data-gallery-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      lightbox.open({
        image: trigger.getAttribute('data-gallery-image') || '',
        title: trigger.getAttribute('data-gallery-title') || '',
        description: trigger.getAttribute('data-gallery-description') || '',
        href: trigger.getAttribute('data-gallery-href') || '',
        cta: trigger.getAttribute('data-gallery-cta') || '',
      });
    });
  });
</script>

<style>
  .lightbox {
    align-items: center;
    display: flex;
    height: 100vh;
    inset: 0;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    transition: opacity 0.3s ease;
    width: 100vw;
    z-index: 1000;
  }

  .lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__backdrop {
    background: rgba(74, 51, 38, 0.9);
    inset: 0;
    position: absolute;
  }

  .lightbox__content {
    background: var(--paper);
    border-radius: 1rem;
    max-height: 90vh;
    max-width: 92vw;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .lightbox__img {
    border-radius: 1rem 1rem 0 0;
    display: block;
    height: auto;
    margin: 0 auto;
    max-height: calc(90vh - 200px);
    max-width: 100%;
    width: auto;
  }

  .lightbox__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.5rem 1.5rem;
  }

  .lightbox__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .lightbox__description {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  .lightbox__link {
    align-self: flex-start;
    color: var(--cocoa);
    font-size: 0.88rem;
    font-weight: 600;
    margin-top: 0.35rem;
    text-decoration: none;
  }

  .lightbox__link:hover,
  .lightbox__link:focus-visible {
    color: var(--honey);
    outline: none;
  }

  .lightbox__link:focus-visible {
    box-shadow: 0 2px 0 0 rgba(214, 165, 75, 0.6);
  }

  .lightbox__close {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    color: var(--cocoa);
    cursor: pointer;
    font-size: 1.5rem;
    height: 40px;
    line-height: 1;
    padding: 0;
    position: absolute;
    right: -0.5rem;
    top: -0.5rem;
    transition: background 0.2s ease;
    width: 40px;
    z-index: 2;
  }

  .lightbox__close:hover {
    background: #fff;
  }
</style>
