---
import MainLayout from '../layouts/MainLayout.astro';
import CartItem from '../components/cart/CartItem.astro';
import CartSummary from '../components/cart/CartSummary.astro';
import { sitePath } from '../utils/paths';
---

<MainLayout
  title="Cart | RIPPLE Bakes & Makes"
  description="Review your RIPPLE Bakes & Makes cart."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Cart</span>
      <h1 class="display">Your handmade<br /><em>order list.</em></h1>
      <p>Review the items you have set aside before the checkout flow is connected.</p>
    </div>
  </section>

  <section class="section">
    <div class="container cart-layout">
      <div class="cart-list" data-cart-list></div>

      <div class="cart-empty" data-cart-empty hidden>
        <h2>Your cart is empty</h2>
        <p>Start with a bakery treat or a handmade sewing piece.</p>
        <div class="cart-empty__links">
          <a class="button button--honey" href={sitePath('bakery')}>Browse bakery</a>
          <a class="button button--light" href={sitePath('sewing')}>Browse sewing</a>
        </div>
      </div>

      <CartSummary />
    </div>
  </section>

  <CartItem />
</MainLayout>

<script>
import type { Cart } from '../types/cart';
import {
  clearCart,
  getCart,
  removeFromCart,
  updateCartItemQuantity,
} from '../utils/cart';
import { getCartTotal } from '../utils/order';
import { formatLabel, formatPrice } from '../utils/format';
import { formatOptionValue } from '../utils/option-pricing';

  const cartList = document.querySelector<HTMLElement>('[data-cart-list]');
  const emptyState = document.querySelector<HTMLElement>('[data-cart-empty]');
  const summary = document.querySelector<HTMLElement>('[data-cart-summary]');
  const clearButton = document.querySelector<HTMLElement>('[data-cart-clear]');
  const totalCount = document.querySelector<HTMLElement>('[data-cart-total-count]');
  const totalLabel = document.querySelector<HTMLElement>('[data-cart-total-label]');
  const template = document.querySelector<HTMLTemplateElement>('#cart-item-template');

const updateSummary = (cart: Cart) => {
  const count = cart.items.reduce((total, item) => total + item.quantity, 0);
  const total = getCartTotal(cart);
  const totalPrice = formatPrice(total);

  if (totalCount) totalCount.textContent = String(count);
  if (totalLabel) totalLabel.textContent = count === 1 ? 'item' : 'items';

  const totalPriceEl = document.querySelector<HTMLElement>('[data-cart-total-price]');
  if (totalPriceEl) {
    totalPriceEl.textContent = totalPrice || '$0.00';
  }
};

const renderCart = () => {
  const cart = getCart();

  if (!cartList || !emptyState || !summary || !template) return;

  cartList.textContent = '';
  updateSummary(cart);

  const hasItems = cart.items.length > 0;
  emptyState.hidden = hasItems;
  summary.hidden = !hasItems;

  if (!hasItems) return;

  cart.items.forEach((item) => {
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const cartItem = fragment.querySelector<HTMLElement>('[data-cart-item]');
    const title = fragment.querySelector<HTMLElement>('[data-cart-item-title]');
    const collection = fragment.querySelector<HTMLElement>('[data-cart-item-collection]');
    const configuration = fragment.querySelector<HTMLElement>('[data-cart-item-configuration]');
    const notes = fragment.querySelector<HTMLElement>('[data-cart-item-notes]');
    const quantity = fragment.querySelector<HTMLElement>('[data-cart-item-quantity]');
    const decrease = fragment.querySelector<HTMLElement>('[data-cart-decrease]');
    const increase = fragment.querySelector<HTMLElement>('[data-cart-increase]');
    const remove = fragment.querySelector<HTMLElement>('[data-cart-remove]');
    const unitPriceEl = fragment.querySelector<HTMLElement>('[data-cart-item-unit-price]');
    const lineTotalEl = fragment.querySelector<HTMLElement>('[data-cart-item-line-total]');

    if (
      !cartItem ||
      !title ||
      !collection ||
      !configuration ||
      !notes ||
      !quantity ||
      !decrease ||
      !increase ||
      !remove
    ) {
      return;
    }

    cartItem.dataset.cartItemId = item.id;
    title.textContent = item.productTitle;
    collection.textContent = formatLabel(item.collectionId);
    quantity.textContent = String(item.quantity);
    notes.textContent = item.notes ? `Notes: ${item.notes}` : '';

    Object.entries(item.configuration).forEach(([key, value]) => {
      const term = document.createElement('dt');
      const description = document.createElement('dd');

      term.textContent = formatLabel(key);
      description.textContent = formatOptionValue(value);
      configuration.append(term, description);
    });

    const unitPrice = formatPrice(item.price);
    const lineTotal = formatPrice((item.price ?? 0) * item.quantity);

    if (unitPriceEl) {
      unitPriceEl.textContent = unitPrice ? `Unit Price: ${unitPrice}` : '';
    }

    if (lineTotalEl) {
      lineTotalEl.textContent = lineTotal ? `Total: ${lineTotal}` : '';
    }

    decrease.addEventListener('click', () => {
      updateCartItemQuantity(item.id, item.quantity - 1);
      renderCart();
    });

    increase.addEventListener('click', () => {
      updateCartItemQuantity(item.id, item.quantity + 1);
      renderCart();
    });

    remove.addEventListener('click', () => {
      removeFromCart(item.id);
      renderCart();
    });

    cartList.append(fragment);
  });
};

  clearButton?.addEventListener('click', () => {
    clearCart();
    renderCart();
  });

  window.addEventListener('ripple-cart:updated', renderCart);
  window.addEventListener('storage', renderCart);
  renderCart();
</script>

<style>
  .cart-layout{align-items:start;display:grid;gap:2rem;grid-template-columns:1fr 320px}
  .cart-list{display:grid;gap:1rem}
  .cart-empty{background:var(--paper);border:1px solid var(--line);border-radius:1.1rem;padding:2rem}
  .cart-empty h2{font-family:'Playfair Display',Georgia,serif;font-size:2rem;font-weight:500;letter-spacing:-.04em;margin:0 0 .5rem}
  .cart-empty p{color:var(--muted);margin:0 0 1.25rem}
  .cart-empty__links{display:flex;flex-wrap:wrap;gap:.75rem}
  @media(max-width:820px){.cart-layout{grid-template-columns:1fr}}
</style>
