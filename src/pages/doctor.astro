---
import fs from 'node:fs';
import path from 'node:path';
import MainLayout from '../layouts/MainLayout.astro';

type OwnerReport = {
  generated: string;
  version: string;
  website: { score: number; maxScore: number; status: string; checks: { passed: number; warnings: number; failures: number } };
  business: { score: number; maxScore: number; status: string; products: Record<string, number>; images: { total: number; averagePerProduct: number }; forms: Record<string, number> };
  healthTable: { check: string; result: string; status: string }[];
  recommendations: { priority: string; area: string; text: string }[];
};

let report: OwnerReport | null = null;
let error: string | null = null;
try {
  const p = path.resolve(process.cwd(), 'scripts/doctor/reports/doctor-report-owner.json');
  if (fs.existsSync(p)) {
    report = JSON.parse(fs.readFileSync(p, 'utf-8')) as OwnerReport;
  } else {
    error = 'Doctor report not yet generated. Run npm run doctor first.';
  }
} catch {
  error = 'Could not read doctor report.';
}
---

<MainLayout title="Health Dashboard | RIPPLE Bakes & Makes" description="Site health and business readiness dashboard.">

{
  error ? (
    <section class="page-hero"><div class="container"><p class="eyebrow">Doctor</p><h1 class="display">Health <em>Dashboard</em></h1><p style="color: var(--muted); margin-top: 1rem;">{error}</p></div></section>
  ) : (
    <>
      <section class="page-hero"><div class="container"><span class="eyebrow">Doctor</span><h1 class="display">Health <em>Dashboard</em></h1><p style="color: var(--muted); margin-top: 0.5rem;">Generated {new Date(report!.generated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p></div></section>

      <section class="section"><div class="container">
        <div class="status-grid">
          <div class="status-card">
            <span class="status-label">Website Health</span>
            <span class={"status-score " + (report!.website.status === 'GOOD' ? 'good' : report!.website.status === 'ATTENTION' ? 'attention' : 'critical')}>{report!.website.score}<span class="status-max">/{report!.website.maxScore}</span></span>
            <span class={"status-badge " + (report!.website.status === 'GOOD' ? 'badge-good' : report!.website.status === 'ATTENTION' ? 'badge-attention' : 'badge-critical')}>{report!.website.status}</span>
            <p class="status-detail">{report!.website.checks.passed} passed, {report!.website.checks.warnings} warnings, {report!.website.checks.failures} failures</p>
          </div>
          <div class="status-card">
            <span class="status-label">Business Health</span>
            <span class={"status-score " + (report!.business.status === 'GOOD' ? 'good' : report!.business.status === 'ATTENTION' ? 'attention' : 'critical')}>{report!.business.score}<span class="status-max">/{report!.business.maxScore}</span></span>
            <span class={"status-badge " + (report!.business.status === 'GOOD' ? 'badge-good' : report!.business.status === 'ATTENTION' ? 'badge-attention' : 'badge-critical')}>{report!.business.status}</span>
            <p class="status-detail">{report!.business.products.active} active products, {report!.business.products.featured} featured</p>
          </div>
        </div>
      </div></section>

      <section class="section section--paper"><div class="container">
        <span class="eyebrow" style="margin-bottom: 1.5rem; display: block;">Health overview</span>
        <table class="health-table">
          <thead><tr><th>Check</th><th>Result</th><th>Status</th></tr></thead>
          <tbody>
            {report!.healthTable.map(row => (
              <tr>
                <td>{row.check}</td>
                <td>{row.result}</td>
                <td><span class={"table-status " + (row.status === 'Good' ? 'table-good' : row.status === 'Needs attention' ? 'table-attention' : 'table-critical')}>{row.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div></section>

      {
        report!.recommendations.length > 0 && (
          <section class="section"><div class="container">
            <span class="eyebrow" style="margin-bottom: 1.5rem; display: block;">Recommended actions</span>
            <div class="recs">
              {report!.recommendations.map(r => (
                <div class={"rec " + (r.priority === 'HIGH' ? 'rec-high' : 'rec-med')}>
                  <span class="rec-priority">{r.priority === 'HIGH' ? 'High' : 'Medium'}</span>
                  <span class="rec-area">{r.area}</span>
                  <p class="rec-text">{r.text}</p>
                </div>
              ))}
            </div>
          </div></section>
        )
      }

      <section class="section"><div class="container" style="text-align: center; padding-bottom: 3rem;">
        <p style="color: var(--muted); font-size: 0.85rem;">This dashboard is updated when <code style="background: var(--paper); padding: 0.15rem 0.4rem; border-radius: 4px; font-family: monospace;">npm run doctor</code> is run.</p>
      </div></section>
    </>
  )
}

</MainLayout>

<style>
  .status-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr 1fr;
  }
  .status-card {
    background: var(--cream);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
  }
  .status-label {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .status-score {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    font-weight: 500;
    line-height: 1;
    margin: 0.75rem 0;
  }
  .status-score.good { color: var(--sage); }
  .status-score.attention { color: var(--honey); }
  .status-score.critical { color: var(--cocoa); }
  .status-max {
    color: var(--muted);
    font-size: 1.2rem;
    font-weight: 400;
  }
  .status-badge {
    border-radius: 999px;
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.9rem;
    text-transform: uppercase;
  }
  .badge-good { background: var(--sage); color: white; }
  .badge-attention { background: var(--honey); color: white; }
  .badge-critical { background: var(--cocoa); color: white; }
  .status-detail {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }
  .health-table {
    border-collapse: collapse;
    width: 100%;
  }
  .health-table th {
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    text-align: left;
    text-transform: uppercase;
  }
  .health-table td {
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
    padding: 1rem;
  }
  .health-table td:first-child { font-weight: 500; }
  .table-status {
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
  }
  .table-good { background: #e8f0e9; color: #4a7c5e; }
  .table-attention { background: #f5edd6; color: #8b7a38; }
  .table-critical { background: #f0e4e0; color: #7a4a3a; }
  .recs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .rec {
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }
  .rec-high {
    background: #fdf2ed;
    border-left: 3px solid var(--cocoa);
  }
  .rec-med {
    background: var(--cream);
    border-left: 3px solid var(--honey);
  }
  .rec-priority {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .rec-high .rec-priority { color: var(--cocoa); }
  .rec-med .rec-priority { color: #b8943a; }
  .rec-area {
    font-size: 0.75rem;
    margin-left: 0.5rem;
    opacity: 0.6;
  }
  .rec-text {
    font-size: 0.9rem;
    margin: 0.25rem 0 0;
  }
  @media (max-width: 650px) {
    .status-grid { grid-template-columns: 1fr; }
    .health-table { font-size: 0.85rem; }
    .health-table th, .health-table td { padding: 0.6rem 0.75rem; }
  }
</style>
