---
import MainLayout from '../layouts/MainLayout.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import GalleryFilter from '../components/gallery/GalleryFilter.astro';
import Lightbox from '../components/gallery/Lightbox.astro';
import { getGalleryItems } from '../utils/gallery';

const galleryItems = getGalleryItems();
---

<MainLayout
  title="Gallery | RIPPLE Bakes & Makes"
  description="A curated gallery of artisan baking, handmade sewing, and creative pieces from the RIPPLE kitchen and studio."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">The gallery</span>
      <h1 class="display">Little moments, <em>beautifully made.</em></h1>
      <p>A curated look at what comes from the kitchen and the studio — handpicked bakes, handmade pieces, and the details that make them special.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div data-gallery-filter-bar aria-label="Filter gallery by business area">
        <GalleryFilter activeFilter="all" />
      </div>
      <GalleryGrid items={galleryItems} />
    </div>
  </section>

  <Lightbox />
</MainLayout>
