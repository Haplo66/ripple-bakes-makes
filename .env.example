# Set to "true" to use Google Sheets instead of CSV files
# SHEETS_ENABLED=true

# Google Sheets spreadsheet ID (from the sheet URL)
# GOOGLE_SHEETS_ID=

# Service account email for Google Sheets API
# GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key (with \n escaped)
# GOOGLE_SHEETS_PRIVATE_KEY=

# Google Drive folder ID for product images (from the folder URL)
# Points to: RIPPLE > Assets > Product Images
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
