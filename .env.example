# Set to "true" to use Google Sheets instead of CSV files
# SHEETS_ENABLED=true

# ─────────────────────────────────────────────
# Spreadsheet 1 of 2 — Inventory Spreadsheet
# Contains:
#   Products
#   Collections
#   Forms
# ─────────────────────────────────────────────
# Google Sheets spreadsheet ID (from the sheet URL)
# INVENTORY_GOOGLE_SHEETS_ID=

# ─────────────────────────────────────────────
# Spreadsheet 2 of 2 — Orders Spreadsheet
# Contains:
#   Orders
#   Order Items
#   Inquiries
#   Orders Config
#   Doctor Config
# ─────────────────────────────────────────────
# ORDERS_GOOGLE_SHEETS_ID=

# Service account email for Google Cloud API
# GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (with \n escaped)
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Drive root folder ID (from the folder URL)
# Points to the "RIPPLE Business Data" top-level folder
# The importer navigates: RIPPLE Business Data > Assets > Product Images
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Apps Script Web App URL for all submissions (orders + inquiries)
# Deploy the Apps Script from the OrderWorkflow project, then paste the URL here.
# Must match the secret in GitHub Actions (`PUBLIC_SUBMISSION_ENDPOINT`).
# PUBLIC_SUBMISSION_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional shared secret for Apps Script token validation
# Must match the TOKEN value in the Apps Script project.
# PUBLIC_ORDER_TOKEN=

# ─────────────────────────────────────────────
# Doctor — Email Delivery
# ─────────────────────────────────────────────
# Doctor sends health reports via the Apps Script Web App
# (same endpoint used for orders and inquiries).
# Enable/disable and recipient settings are managed in the
# "Doctor Config" sheet tab of the Orders Spreadsheet.
# PUBLIC_SUBMISSION_ENDPOINT and PUBLIC_ORDER_TOKEN (above) are
# required for Doctor email delivery.

# ─────────────────────────────────────────────
# Doctor — Google Analytics 4
# ─────────────────────────────────────────────
# GA4 Measurement ID for website visitor tracking.
# Only needed for Doctor Visitors metrics.
# PUBLIC_GA4_MEASUREMENT_ID=

