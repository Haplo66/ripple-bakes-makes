# Set to "true" to use Google Sheets instead of CSV files
# SHEETS_ENABLED=true

# Google Sheets spreadsheet ID (from the sheet URL)
# INVENTORY_GOOGLE_SHEETS_ID=

# Service account email for Google Cloud API
# GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (with \n escaped)
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Drive root folder ID (from the folder URL)
# Points to the "RIPPLE Business Data" top-level folder
# The importer navigates: RIPPLE Business Data > Assets > Product Images
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Apps Script Web App URL for all submissions (orders + inquiries)
# Deploy the Apps Script from the OrderWorkflow project, then paste the URL here.
# Must match the secret in GitHub Actions (`PUBLIC_SUBMISSION_ENDPOINT`).
# PUBLIC_SUBMISSION_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional shared secret for Apps Script token validation
# Must match the TOKEN value in the Apps Script project.
# PUBLIC_ORDER_TOKEN=

# ─────────────────────────────────────────────
# Doctor — Email Automation
# ─────────────────────────────────────────────
# Set to "true" to enable email delivery after running Doctor.
# DOCTOR_EMAIL_ENABLED=true
#
# Recipient and sender email addresses.
# DOCTOR_EMAIL_TO=owner@ripplebakesandmakes.com
# DOCTOR_EMAIL_FROM=doctor@ripplebakesandmakes.com
#
# SMTP configuration (defaults to Gmail SMTP).
# For Google Workspace, use an App Password (requires 2FA).
# DOCTOR_SMTP_HOST=smtp.gmail.com
# DOCTOR_SMTP_PORT=587
# DOCTOR_SMTP_USER=doctor@ripplebakesandmakes.com
# DOCTOR_SMTP_SECRET=
